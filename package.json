{
  "name": "frazer-raiser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bunx convex deploy --cmd 'next build'",
    "check": "oxlint --deny-warnings . && tsc --noEmit",
    "check:all": "bun run typecheck && bun run format:check && bun run lint && bun run knip",
    "fix:all": "bun run format:write && bun run lint:fix",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "knip": "knip",
    "knip:deps": "knip --deps",
    "dev": "bunx convex deploy --cmd 'next dev --turbo'",
    "preview": "next build && next start",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
